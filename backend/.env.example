# Railway sets DATABASE_URL automatically when you reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Using GNAT_DB_PORT=5434 with docker compose? Change 5432 to 5434 here.
DATABASE_URL=postgres://gnat:gnat@localhost:5432/gnat

# Long random string (at least 32 characters). Never change it after launch:
# it also encrypts the stored access codes.
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin(s), comma separated. Wildcards allowed for preview deploys.
ALLOWED_ORIGINS=http://localhost:5173

# The first admin (Regional Secretary) is created on first boot.
ADMIN_EMAIL=secretary@example.com
# Temporary: the first sign-in must replace it.
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Regional Secretary

NODE_ENV=development

# Demo site only (its own Railway service + database). Shows one-tap sign-in for
# every role with fictional data. The API refuses to start in demo mode on a
# database that already holds data, and refuses real mode on a demo database.
# DEMO_MODE=true
